{
  "name": "DollCatcher",
  "appId": "com.dollcatcher.toss",
  "version": "1.0.0",
  "description": "인형뽑기 매장 찾기 서비스",
  "entry": "./",
  "output": "./dist",
  "platform": ["ios", "android"],
  "webview": {
    "userAgent": "Toss/WebView",
    "allowsInlineMediaPlayback": true,
    "mediaPlaybackRequiresUserAction": false,
    "allowsAirPlayForMediaPlayback": true,
    "dataDetectorTypes": "none",
    "allowsBackForwardNavigationGestures": true,
    "allowsLinkPreview": false,
    "ignoresViewportScaleLimits": false,
    "suppressesIncrementalRendering": false,
    "allowsInlineMediaPlayback": true
  },
  "permissions": {
    "location": {
      "required": true,
      "description": "주변 인형뽑기 매장을 찾기 위해 위치 정보가 필요합니다"
    },
    "camera": {
      "required": false,
      "description": "리뷰 사진 촬영을 위해 카메라 권한이 필요합니다"
    },
    "photo": {
      "required": false,
      "description": "리뷰 사진 선택을 위해 앨범 접근 권한이 필요합니다"
    }
  },
  "features": {
    "navigation": true,
    "share": true,
    "haptic": true,
    "analytics": true,
    "deeplink": true,
    "push": false
  },
  "build": {
    "framework": "nextjs",
    "bundler": "webpack",
    "sourceMap": false,
    "minify": true,
    "optimization": {
      "images": true,
      "fonts": true,
      "css": true,
      "js": true
    }
  },
  "bridge": {
    "ios": {
      "scheme": "tossBridge",
      "handler": "tossBridge"
    },
    "android": {
      "interface": "TossBridge",
      "namespace": "window.Android"
    }
  },
  "routes": {
    "home": "/",
    "map": "/map",
    "reviews": "/reviews/:storeId",
    "terms": "/terms"
  },
  "theme": {
    "primaryColor": "#3182F6",
    "backgroundColor": "#FFFFFF",
    "statusBar": {
      "style": "dark",
      "backgroundColor": "#FFFFFF"
    }
  }
}