{
  "name": "DollCatcher - 인형뽑기 매장 찾기",
  "short_name": "DollCatcher",
  "description": "내 주변 인형뽑기 매장을 쉽고 빠르게 찾아보세요",
  "version": "1.0.0",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#3182F6",
  "background_color": "#FFFFFF",
  "categories": ["entertainment", "lifestyle"],
  "lang": "ko",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "toss": {
    "webview": true,
    "bridge": "tossBridge",
    "safeArea": true,
    "fullscreen": false,
    "permissions": {
      "geolocation": "required",
      "camera": "optional",
      "storage": "optional"
    },
    "features": {
      "haptic": true,
      "share": true,
      "analytics": true
    }
  }
}